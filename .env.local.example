# Local development — frontend talks to backend on your machine
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api

# Production (Vercel): leave unset (defaults to same-origin /api) OR set:
# NEXT_PUBLIC_API_BASE_URL=/api
# API_PROXY_TARGET=https://examshaathi-backend.onrender.com
#
# Do NOT point the browser at onrender.com directly — cross-site cookies get
# blocked and /user/refresh-token returns "Refresh token not found!".

# Optional: force API console logs in a production build
# NEXT_PUBLIC_DEBUG_API=true
